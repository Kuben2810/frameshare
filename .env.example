# Database
DATABASE_URL=postgresql://frameshare:frameshare@localhost:5432/frameshare

# Auth
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Drive BYO storage — deliberately separate from login OAuth. Create a
# Web client with only https://www.googleapis.com/auth/drive.file and register
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI exactly (for example,
# https://your-domain/api/storage/google-drive/callback).
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3005/api/storage/google-drive/callback
# Browser-safe Google Picker API key, restricted to Frameshare origins.
NEXT_PUBLIC_GOOGLE_DRIVE_PICKER_API_KEY=
# Google Cloud project number required by Google Picker when using drive.file.
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=
# Generate with: openssl rand -base64 32. Keep this private and plan key
# rotation before changing it; it encrypts stored Drive refresh tokens.
STORAGE_CREDENTIALS_KEY=
# Optional distinct HMAC secret for short-lived OAuth state. Defaults to the
# credentials key when omitted.
STORAGE_OAUTH_STATE_SECRET=

# Optional separate key for privacy-preserving public submission rate limits.
# Defaults to AUTH_SECRET when omitted.
RATE_LIMIT_SECRET=

# Optional server key for the authenticated AI prototype.
GEMINI_API_KEY=

# S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=frameshare
S3_FORCE_PATH_STYLE=true
# Public URL for serving files (MinIO local / R2 public URL / etc.)
S3_PUBLIC_URL=http://localhost:9000/frameshare

# Email — set RESEND_API_KEY for hosted, or SMTP_* for self-hosted
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@frameshare.app

# Storage quota per user (bytes) — default 10 GB
STORAGE_LIMIT_BYTES=10737418240
